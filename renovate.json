{
  "extends": [
    "config:base"
  ],
  "pip-compile": {
    "enabled": true,
    "fileMatch": [
      "(^|/)requirements\\.in$"
    ]
  },
  "constraints": {
    "python": "~=3.7.0"
  },
  "prConcurrentLimit": 5,
  "stabilityDays": 7,
  "vulnerabilityAlerts": {
    "labels": [
      "type:security"
    ],
    "stabilityDays": 0
  },
  "labels": [
    "dependencies"
  ],
  "python": {
    "addLabels": [
      "lang: python"
    ]
  },
  "java": {
    "addLabels": [
      "lang: java"
    ]
  },
  "golang": {
    "addLabels": [
      "lang: go"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "staticcheck pin in the go-checkstyle job",
      "fileMatch": [
        "^\\.circleci/config\\.yml$"
      ],
      "matchStrings": [
        "honnef\\.co/go/tools/cmd/staticcheck@(?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "honnef.co/go/tools",
      "datasourceTemplate": "go"
    }
  ]
}
